# Modèle du fichier .env lu par Docker Compose.
# Ne le remplissez pas à la main : `make env` le crée avec des secrets aléatoires.

SECRET_KEY=
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
MONGO_PASSWORD=

INVITE_CODE=
WEB_PORT=8080
COOKIE_SECURE=false
TRUSTED_PROXIES=1
SITE_DOMAIN=

INACTIVE_ACCOUNT_MONTHS=24
ACTIVITY_RETENTION_DAYS=180

AI_PROVIDER=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
