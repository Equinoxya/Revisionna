# Flask
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Base de donnees relationnelle (SQL)
# dev : SQLite ; prod/docker : PostgreSQL
DATABASE_URL=sqlite:///revisionna.db
# DATABASE_URL=postgresql+psycopg2://revisionna:revisionna@db:5432/revisionna

# Base NoSQL (optionnelle, utilisee par le cours NoSQL et le journal d'activite)
MONGO_URL=
MONGO_DB=revisionna

# Integration IA : "ollama", "openai" ou "" (desactive -> reponses locales)
AI_PROVIDER=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
