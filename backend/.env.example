# Développement local, sans Docker (`flask run`). Copiez ce fichier en `.env`.
FLASK_ENV=development

# En développement, des clés de confort sont utilisées si celles-ci sont vides.
# En production (FLASK_ENV=production), l'application refuse de démarrer sans
# deux clés d'au moins 32 caractères : voir `make env` à la racine du dépôt.
SECRET_KEY=
JWT_SECRET_KEY=

# SQLite en développement ; PostgreSQL avec Docker Compose.
DATABASE_URL=sqlite:///revisionna.db

# Journal d'activité MongoDB (facultatif)
MONGO_URL=
MONGO_DB=revisionna

# Code d'invitation exigé à l'inscription (vide = inscriptions ouvertes)
INVITE_CODE=

# Tuteur IA : vide (désactivé), "ollama" (local) ou "openai" (distant)
AI_PROVIDER=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Correction des TP : en développement, le code s'exécute dans un sous-processus
# local limité (suffisant sur votre propre machine, pas pour des inconnus).
# Avec Docker Compose, il part dans un conteneur isolé (RUNNER_SOCKET).
RUNNER_SOCKET=
